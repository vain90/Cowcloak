# Cowcloak application
# --------------------

# Public HTTPS URL used for OAuth callbacks and application URLs.
# Do not add a trailing slash.
COWCLOAK_BASE_URL=https://aliases.example.com

# Secret used to sign Cowcloak sessions. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
COWCLOAK_SESSION_SECRET=replace-with-a-long-random-secret

# Keep enabled for normal HTTPS deployments.
# Set to false only for local HTTP development where secure cookies cannot be used.
COWCLOAK_COOKIE_SECURE=true

# Comma-separated Host header values accepted by Cowcloak.
# Usually this is the hostname from COWCLOAK_BASE_URL.
# "*" allows every host and is not recommended for an Internet-facing deployment.
COWCLOAK_TRUSTED_HOSTS=aliases.example.com


# mailcow connection
# ------------------

# Base URL of the mailcow instance. Do not add a trailing slash.
MAILCOW_URL=https://mail.example.com

# mailcow read/write API key used to create and manage aliases.
# Restrict the key to the Cowcloak server's source IP in mailcow where possible.
MAILCOW_API_KEY=replace-with-mailcow-read-write-api-key

# OAuth2 client configured in mailcow.
# Redirect URI: <COWCLOAK_BASE_URL>/oauth/callback
MAILCOW_OAUTH_CLIENT_ID=replace-with-oauth-client-id
MAILCOW_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret

# Verify the TLS certificate presented by mailcow.
# Disable only when intentionally using an internal/self-signed certificate.
MAILCOW_VERIFY_TLS=true


# Docker Compose deployment
# -------------------------

# Host port published by the repository's compose.yml.
# Ignored by deployments such as a private reverse-proxy network that do not publish a port.
COWCLOAK_PORT=8080

# Container image channel or fixed image tag used by Docker Compose.
# latest = latest stable release
# edge   = current unreleased main branch
# A fixed SemVer tag such as 0.1.2 can also be used for a pinned deployment.
# update.sh overrides this value for its own stable/beta invocation without editing .env.
COWCLOAK_TAG=latest


# Updater-only shell option
# -------------------------

# COWCLOAK_COMPOSE_FILE is supported by update.sh when a deployment uses a custom
# Compose filename. It is a shell environment variable and is intentionally not
# defined as a normal .env setting because update.sh does not source this file.
# Example:
#   COWCLOAK_COMPOSE_FILE=compose.production.yml ./update.sh
